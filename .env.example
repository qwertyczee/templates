NODE_ENV=development
PORT=8080

# Database (Postgres)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# JWT
JWT_ACCESS_SECRET=replace_with_strong_secret_for_access
JWT_REFRESH_SECRET=replace_with_strong_secret_for_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Resend Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM_NAME=Your App Name
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_FRONTEND_URL=http://localhost:3000/auth/callback

# Frontend (pro CORS a případné redirecty)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Axiom
AXIOM_TOKEN=
AXIOM_DATASET=logs-backend

# PostHog
POSTHOG_API_KEY= your_posthog_api_key
POSTHOG_HOST=https://app.posthog.com